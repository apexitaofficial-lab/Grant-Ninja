# ---------------------------------------------------------------------------
# Grant Ninja — frontend environment
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> publishable key (starts with `sb_publishable_`).
# This is the modern replacement for the legacy `anon` JWT. Safe to expose to
# the browser — Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> secret key (starts with `sb_secret_`).
# The modern replacement for the legacy `service_role` JWT.
# SERVER ONLY. Bypasses Row Level Security. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- AI -------------------------------------------------------------------
# Nothing here. Every Gemini call happens in the Python pipeline, which holds
# its own key in python/.env — see python/.env.example. Putting a copy on the
# web host would be a second place to leak it from, for no benefit.

# --- Email (Resend) -------------------------------------------------------
# All three are OPTIONAL. Leave them empty and the site runs normally — the
# contact form still stores every message, it just does not email anyone about
# it. That keeps local development working without a Resend account.
#
# A contact submission sends two emails, both from RESEND_FROM_EMAIL:
#   1. an acknowledgement to the person who wrote in
#   2. the enquiry itself to CONTACT_NOTIFICATION_EMAIL
#
# resend.com -> API Keys. Server only, never NEXT_PUBLIC_.
RESEND_API_KEY=

# The "from" address for both emails.
#
# Resend only accepts an address on a domain verified with it: Domains -> Add
# Domain, then add the DNS records it gives you. To send as dev@apexita.com,
# APEXITA.COM must be the verified domain — not grantninja.com.
#
# Until a domain is verified the only value Resend accepts is
# onboarding@resend.dev, and it delivers ONLY to your own Resend account
# address. Fine for a first test, useless in production.
RESEND_FROM_EMAIL=dev@apexita.com

# Where the enquiry notification goes. Reply-To is set to the person who wrote
# in, so answering is just hitting reply.
CONTACT_NOTIFICATION_EMAIL=adamanthony987@gmail.com

# --- Site -----------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, OpenGraph and sitemaps.
# Local: http://localhost:3000    Production: https://grantninja.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SITE_NAME=Grant Ninja
