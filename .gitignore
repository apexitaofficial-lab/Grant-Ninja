# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
.vercel

# Environment — never commit real keys
.env
.env.local
.env.*.local
!.env.example

# Supabase CLI scratch state.
#
# `.temp` caches the linked project, the pooler URL and version checks for one
# machine. It holds no secrets, but it is per-developer state that churns on
# every CLI invocation — committing it means a diff every time anyone runs a
# command. Supabase's own template excludes it.
supabase/.temp/
supabase/.branches/

# Claude Code local settings.
#
# `settings.local.json` is a per-machine permissions allowlist that records the
# commands that have been approved — including their full text, which means any
# secret ever passed inline on a command line ends up in it. It is personal to
# one machine and must never be committed. `settings.json` is the shared
# project config and is safe to track.
.claude/settings.local.json

# Python
python/.venv/
python/venv/
# A typo'd virtualenv (`vevn`) slipped past the two rules above and committed
# Windows executables — useless on the Ubuntu server they get cloned to.
python/vevn/
python/env/
# Nothing in this project legitimately ships a Windows binary, so this catches
# the next mistyped environment directory rather than waiting for someone to
# notice it.
*.exe
*.dll
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# Crawler artefacts
python/.crawl4ai/
python/cache/
python/output/

# Testing
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
