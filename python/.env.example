# ---------------------------------------------------------------------------
# Grant Ninja - Python AI pipeline environment
# MASTER_PROJECT_SPEC.md Part 4A "Configuration" and section 141.
# Copy to `python/.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Same project as the frontend. The pipeline writes with the secret key
# (`sb_secret_...`), so it bypasses Row Level Security by design.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- AI -------------------------------------------------------------------
GEMINI_API_KEY=
# Verified working 2026-08-20. gemini-2.5-flash returns 404 for new API keys.
GEMINI_MODEL=gemini-3.6-flash

# --- Crawler --------------------------------------------------------------
# Descriptive agent string - MASTER_PROJECT_SPEC.md section 12 (crawler ethics).
USER_AGENT=GrantNinjaBot/1.0 (+https://grantninja.com/about)
CRAWL_TIMEOUT=30
PLAYWRIGHT_TIMEOUT=60
MAX_RETRIES=3
# Seconds between requests to the same host.
REQUEST_DELAY=2
MAX_CONCURRENT_JOBS=4
HEADLESS=true
RESPECT_ROBOTS_TXT=true

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=INFO
DEFAULT_COUNTRY=united-states
# Run every stage but write nothing. Used to rehearse a new source.
DRY_RUN=false
